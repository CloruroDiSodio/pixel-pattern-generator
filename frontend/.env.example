# Base URL of the FastAPI backend.
#   - Local development: http://localhost:8000
#   - Production (Netlify env var): https://your-api.onrender.com
# It is inlined into the client bundle at build time - never prefix it with "/".
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this deployment. Used for metadataBase, the canonical URL,
# Open Graph tags, robots.txt and sitemap.xml. Without it the build falls back to
# https://turnipmedia-pixel-pattern-generator.netlify.app, which will be wrong if
# you deploy the site somewhere else.
NEXT_PUBLIC_SITE_URL=https://turnipmedia-pixel-pattern-generator.netlify.app
